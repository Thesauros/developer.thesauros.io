# Partner API / NestJS backend
NODE_ENV=development
API_PORT=3001

# AES-256-GCM for API key secrets (64 hex chars = 32 bytes). Required in production.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Next.js rewrite target for partner routes
PARTNER_API_URL=http://localhost:3001

# PostgreSQL (same vars as Thesauros-Rebalance-Engine)
DB_HOST=localhost
DB_PORT=5432
DB_USER=thesauros
DB_PASSWORD=thesauros
DB_NAME=thesauros_partner
# Set to true for local/sandbox schema sync (no migrations yet)
DB_SYNCHRONIZE=true
# Seed demo partners/campaigns/keys if tables are empty
DB_SEED=true
